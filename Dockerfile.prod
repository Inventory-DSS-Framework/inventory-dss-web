# Production image (Railway / any host).
#
# The plain ./Dockerfile runs the Next.js DEV server and is used by local
# docker-compose. This one builds an optimized production bundle and binds $PORT,
# which is what Railway (and most PaaS) require.
#
# NEXT_PUBLIC_* are inlined at BUILD time, so NEXT_PUBLIC_API_BASE_URL must be present
# during `npm run build`. Railway exposes service variables as build args when declared
# with ARG below — set it in the service's Variables before deploying.
FROM node:20-slim

WORKDIR /app

# Install exact, locked dependencies (package-lock.json is committed and in sync).
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Bake the public API URL into the client bundle.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

COPY . .
RUN npm run build

EXPOSE 3000
# Serve the production build, binding the platform-provided $PORT (3000 locally).
CMD ["sh", "-c", "npm run start -- -p ${PORT:-3000} -H 0.0.0.0"]
